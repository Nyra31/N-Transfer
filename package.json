{
  "name": "n-transfer",
  "productName": "N-Transfer",
  "version": "0.3.0",
  "description": "Pasa fotos, vídeos y archivos entre tu móvil y tu PC por Wi-Fi, con skins al estilo de los 2000",
  "main": "src/main/main.js",
  "author": {
    "name": "Nyra31",
    "email": "335787159+Nyra31@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Nyra31/N-Transfer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nyra31/N-Transfer.git"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/electron.js .",
    "icons": "node scripts/electron.js scripts/make-icons.js",
    "test": "node scripts/test-core.js",
    "shots": "node scripts/shots.js",
    "smoke": "node scripts/smoke-packaged.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.11",
    "heic-convert": "^2.1.0",
    "qrcode": "^1.5.4",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.nyra31.ntransfer",
    "productName": "N-Transfer",
    "copyright": "© 2026 Nyra31",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/main/devshots.js",
      "package.json"
    ],
    "asarUnpack": [
      "src/core/heic-worker.js",
      "node_modules/heic-convert/**",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/**",
      "node_modules/jpeg-js/**",
      "node_modules/pngjs/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "N-Transfer",
      "artifactName": "N-Transfer-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "N-Transfer-${version}-mac.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "N-Transfer recibe y envía archivos a tu móvil por la red local.",
        "NSBonjourServices": ["_ntransfer._tcp"]
      }
    },
    "dmg": {
      "title": "N-Transfer ${version}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Nyra31 <335787159+Nyra31@users.noreply.github.com>",
      "executableName": "n-transfer",
      "synopsis": "Pasa fotos, vídeos y archivos entre tu móvil y tu PC por Wi-Fi",
      "artifactName": "N-Transfer-${version}-${arch}.${ext}",
      "desktop": {
        "entry": { "StartupWMClass": "N-Transfer" }
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nyra31",
        "repo": "N-Transfer",
        "releaseType": "release"
      }
    ]
  }
}
